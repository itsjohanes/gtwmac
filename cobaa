sudo mkdir -p /usr/local/bin
sudo tee /usr/local/bin/igfxdump.sh >/dev/null <<'EOF'
#!/bin/sh
sleep 60
D=/Users/Shared/boot-diag
mkdir -p "$D"
ioreg -l -w0 -p IOService -n IGPU -r > "$D/igpu.txt" 2>&1
ioreg -l -w0 -c AppleIntelFramebuffer > "$D/fb.txt" 2>&1
ioreg -l -w0 -c AppleIntelKBLGraphics > "$D/accel.txt" 2>&1
kextstat > "$D/kextstat.txt" 2>&1
system_profiler SPDisplaysDataType > "$D/displays.txt" 2>&1
nvram -p > "$D/nvram.txt" 2>&1
log show --last boot --style compact > "$D/bootlog.txt" 2>&1
chmod -R a+rX "$D"
date > "$D/DONE"
EOF
sudo chmod 755 /usr/local/bin/igfxdump.sh
sudo tee /Library/LaunchDaemons/local.igfxdump.plist >/dev/null <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.igfxdump</string>
  <key>ProgramArguments</key><array><string>/bin/sh</string><string>/usr/local/bin/igfxdump.sh</string></array>
  <key>RunAtLoad</key><true/>
</dict></plist>
EOF
sudo chown root:wheel /Library/LaunchDaemons/local.igfxdump.plist
sudo chmod 644 /Library/LaunchDaemons/local.igfxdump.plist
APFS=$(diskutil list | awk '/Apple_APFS/ {print $NF; exit}')
DISK=$(echo "$APFS" | sed 's/s[0-9]*$//')
sudo diskutil mount "${DISK}s1" >/dev/null
sudo plutil -replace 'NVRAM.Add.7C436110-AB2A-4BBB-A880-FE41995C9F82.boot-args' -string '-v keepsyms=1 debug=0x100 -no_compat_check agdpmod=vit9696' /Volumes/EFI/EFI/OC/config.plist
sudo plutil -lint /Volumes/EFI/EFI/OC/config.plist
sudo plutil -extract 'NVRAM.Add.7C436110-AB2A-4BBB-A880-FE41995C9F82.boot-args' raw /Volumes/EFI/EFI/OC/config.plist
